# API keys for headless testing. Copy to `.env` and fill in the keys you have.
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is committed, so never put a real key here.
#
# These are read at server start (`transformatron_cli.py start|restart`) and by
# `scripts/smoke_test_transforms.py`. A key exported in your shell overrides the file.
#
# This is a development convenience: it puts credentials in the server process's
# environment, where anyone who can read `ps` can see them. In real use, credentials
# belong in the Maltego client's transform settings, which every transform here reads
# first. Nothing needs to be configured on the server for that path to work.
#
# Restart the server after editing this file — the environment is read once at start.

# https://developer.greynoise.io/ — free Community tier, ~25 lookups/week.
GREYNOISE_API_KEY=

# https://app.crowdsec.net/ — community keys are rate limited.
CROWDSEC_CTI_API_KEY=

# https://ipinfo.io/account/token — Lite tier.
IPINFO_API_TOKEN=

# https://www.ransomware.live/
RANSOMWARE_LIVE_API_KEY=
