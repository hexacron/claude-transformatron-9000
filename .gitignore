.transformatron/
.claude/settings.local.json
# Local working notes. Durable documentation belongs in README/AGENTS/CONTRIBUTING.
HANDOFF.md
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# macOS finder metadata
.DS_Store

# Private integrations. Transforms under transforms/local/ are discovered at server
# start (see project.py) but never committed — this is where work that should not be
# published lives. The package marker is tracked so the directory always exists.
server/transforms/local/*
!server/transforms/local/__init__.py

# Server identity. Each adopter names their own server, so the file is local and
# transformatron.toml.example is the committed template.
transformatron.toml

# Credentials. API keys belong in the Maltego client's transform settings, or in a
# local env file for headless testing — never in the repository.
.env
.env.*
*.env
!.env.example
*.pem
*.key
